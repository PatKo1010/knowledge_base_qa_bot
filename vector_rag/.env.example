OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
MAX_RETRIEVAL_DISTANCE=1.0
# Optional locally; unset uses .kb/conversations.sqlite3.
# Docker Compose configures its own PostgreSQL service.
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Optional cache; chat falls back to SQL if unavailable.
# REDIS_URL=redis://localhost:6379/0
